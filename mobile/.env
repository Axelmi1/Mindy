# MINDY Mobile Environment Configuration
#
# App lancée en local (Expo Go) mais qui parle au backend hébergé sur Render.
# C'est la config par défaut pour tester sans lancer le serveur NestJS en local.
EXPO_PUBLIC_API_URL=https://mindy-api-zsvf.onrender.com/api

# Pour viser un backend NestJS lancé en local à la place, commente la ligne
# ci-dessus et décommente celle-ci avec l'IP LAN de ta machine
# (pas localhost : un téléphone ne voit pas le localhost du Mac) :
# EXPO_PUBLIC_API_URL=http://192.168.1.114:3000/api
